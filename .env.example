# Copiá este archivo como .env.local y completá los valores.
# .env.local NUNCA se sube a git. En Vercel, cargá las mismas variables en
# Project Settings → Environment Variables.

# ─── Sitio ───────────────────────────────────────────────────────────────
# URL pública del sitio, sin barra final. Se usa para el sitemap, robots.txt
# y las URLs absolutas de las metadatas (Open Graph).
NEXT_PUBLIC_SITE_URL=https://estudiolaca.com

# ─── Sanity ──────────────────────────────────────────────────────────────
# ID del proyecto y dataset (sanity.io/manage → tu proyecto). No son secretos.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Secret compartido con el webhook de Sanity. Tiene que ser el mismo valor
# que pongas en el campo "Secret" del webhook. Generalo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SANITY_REVALIDATE_SECRET=

# ─── Formulario de contacto (SMTP de Google Workspace) ──────────────────
# Cuenta que ENVÍA los mensajes y su contraseña de aplicación (16 caracteres,
# sin espacios). Ver README → "Formulario de contacto".
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=alamas@estudiolaca.com
SMTP_PASSWORD=

# Secret para firmar el tiempo de carga del formulario (anti-spam).
# Generalo igual que SANITY_REVALIDATE_SECRET.
CONTACT_FORM_SECRET=
